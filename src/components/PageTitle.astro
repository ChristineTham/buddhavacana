---
// The top of each page, in reading order: breadcrumbs, the title, a date and reading-time line, the
// page's description, and its cover image with the caption. The tags come after the text (Footer.astro).
import { Picture } from "astro:assets";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import readingTime from "reading-time";
import { getBreadcrumbs } from "../lib/breadcrumbs";

const route = Astro.locals.starlightRoute;
const { data, body } = route.entry;
const id = route.entry.id || "index"; // Starlight gives the home page an empty id

const crumbs = await getBreadcrumbs(route);
const minutes = body ? Math.max(1, Math.ceil(readingTime(body).minutes)) : undefined;
const date = route.lastUpdated;
// The site is built on GitHub's runners, which use UTC; show the date as it was where the site is written.
const timeZone = "Australia/Sydney";
// A description made from the page's own text would just repeat its opening, so only show one the
// page was given.
const description = data.descriptionGenerated ? undefined : data.description;
const { cover, summary } = data;

// Descriptions and summaries are plain prose with a little inline Markdown (emphasis, code); render
// just that. (The meta tags get the description with the marks removed, in route-data.ts.)
const escapeHtml = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inlineMarkdown = (text: string) =>
	escapeHtml(text)
		.replace(/`([^`]+)`/g, "<code>$1</code>")
		.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
		.replace(/(^|[^\w*])[*_]([^*_]+)[*_](?=[^\w*]|$)/g, "$1<em>$2</em>");
---

{
	crumbs.length > 1 && id !== "404" && (
		<nav class="breadcrumbs" aria-label="Breadcrumbs">
			<ol>
				{crumbs.slice(0, -1).map(({ label, href }) => <li>{href ? <a href={href}>{label}</a> : label}</li>)}
				<li aria-current="page">{data.title}</li>
			</ol>
		</nav>
	)
}
<Default />
{
	(date || minutes) && (
		<p class="page-meta">
			{date && (
				<time datetime={date.toISOString()}>
					{date.toLocaleDateString("en-AU", { year: "numeric", month: "short", day: "2-digit", timeZone })}
				</time>
			)}
			{date && minutes && " · "}
			{minutes && `${minutes} min read`}
		</p>
	)
}
{description && <p class="description" set:html={inlineMarkdown(description)} />}
{
	cover && (
		<figure class="cover">
			<Picture
				src={cover.image}
				alt={cover.alt}
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 64rem) 64rem, 100vw"
				formats={["avif", "webp"]}
				loading="eager"
				fetchpriority="high"
			/>
			{cover.caption && <figcaption>{cover.caption}</figcaption>}
		</figure>
	)
}
{
	summary && (
		<section class="summary" aria-labelledby="page-summary">
			<h2 id="page-summary">Summary</h2>
			<p set:html={inlineMarkdown(summary)} />
		</section>
	)
}

<style>
	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin: 0 0 0.5rem;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.breadcrumbs li:not(:last-child)::after {
		content: "›";
		margin-inline-start: 0.5rem;
		color: var(--sl-color-gray-3);
	}
	.breadcrumbs a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.breadcrumbs a:hover {
		color: var(--sl-color-accent-high);
	}
	.page-meta {
		margin: 0.5rem 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	/* The description reads as a standfirst: a short, highlighted lead-in to the page. */
	.description {
		margin-block: 1rem 0;
		padding: 0.75rem 1rem;
		border-inline-start: 4px solid var(--sl-color-accent);
		border-start-end-radius: 0.5rem;
		border-end-end-radius: 0.5rem;
		background-color: color-mix(in srgb, var(--sl-color-accent-low) 30%, transparent);
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		line-height: 1.5;
	}
	/* Inline code as in the text (Starlight styles it only inside the page content). */
	.description :global(code),
	.summary :global(code) {
		padding: 0.125rem 0.375rem;
		background-color: var(--sl-color-bg-inline-code);
		font-size: 0.875em;
	}
	.cover {
		margin-block: 1.5rem 0;
	}
	.cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
	.cover figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.summary {
		margin-block: 1.5rem 0;
	}
	.summary h2 {
		margin-bottom: 0.5rem;
		font-size: var(--sl-text-h4);
		color: var(--sl-color-white);
	}
</style>
