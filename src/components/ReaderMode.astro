---
// Reader mode: Quartz v5's ReaderMode button (quartz-community/reader-mode, src/components/ReaderMode.tsx),
// Copyright (c) 2021 jackyzha0, MIT License (see LICENSE-QUARTZ.txt), with a toggle for each sidebar beside it.
//
// Changes from Quartz v5: each sidebar can be hidden on its own, and the book button hides or shows
// both. Hidden sidebars collapse so the page re-flows, rather than fading out in place. Starlight loads
// each page afresh, so the setting is kept for the browser tab (sessionStorage); Head.astro applies it
// before the page paints, so hidden sidebars don't flash.
---

<div class="reader-mode">
	<button
		type="button"
		class="toggle-left"
		data-reader-toggle="left"
		aria-label="Hide the navigation sidebar"
		title="Hide or show the navigation sidebar"
	>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="4" width="18" height="16" rx="2"></rect>
			<path d="M9 4v16"></path>
		</svg>
	</button>
	<button type="button" class="readermode" data-reader-toggle="both" aria-label="Reader mode" title="Reader mode: hide or show both sidebars">
		<svg
			fill="currentColor"
			stroke="currentColor"
			stroke-width="0.2"
			stroke-linecap="round"
			stroke-linejoin="round"
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<g transform="translate(-1.8, -1.8) scale(1.15, 1.2)">
				<path d="M8.9891247,2.5 C10.1384702,2.5 11.2209868,2.96705384 12.0049645,3.76669482 C12.7883914,2.96705384 13.8709081,2.5 15.0202536,2.5 L18.7549359,2.5 C19.1691495,2.5 19.5049359,2.83578644 19.5049359,3.25 L19.5046891,4.004 L21.2546891,4.00457396 C21.6343849,4.00457396 21.9481801,4.28672784 21.9978425,4.6528034 L22.0046891,4.75457396 L22.0046891,20.25 C22.0046891,20.6296958 21.7225353,20.943491 21.3564597,20.9931534 L21.2546891,21 L2.75468914,21 C2.37499337,21 2.06119817,20.7178461 2.01153575,20.3517706 L2.00468914,20.25 L2.00468914,4.75457396 C2.00468914,4.37487819 2.28684302,4.061083 2.65291858,4.01142057 L2.75468914,4.00457396 L4.50368914,4.004 L4.50444233,3.25 C4.50444233,2.87030423 4.78659621,2.55650904 5.15267177,2.50684662 L5.25444233,2.5 L8.9891247,2.5 Z M4.50368914,5.504 L3.50468914,5.504 L3.50468914,19.5 L10.9478955,19.4998273 C10.4513189,18.9207296 9.73864328,18.5588115 8.96709342,18.5065584 L8.77307039,18.5 L5.25444233,18.5 C4.87474657,18.5 4.56095137,18.2178461 4.51128895,17.8517706 L4.50444233,17.75 L4.50368914,5.504 Z M19.5049359,17.75 C19.5049359,18.1642136 19.1691495,18.5 18.7549359,18.5 L15.2363079,18.5 C14.3910149,18.5 13.5994408,18.8724714 13.0614828,19.4998273 L20.5046891,19.5 L20.5046891,5.504 L19.5046891,5.504 L19.5049359,17.75 Z M18.0059359,3.999 L15.0202536,4 L14.8259077,4.00692283 C13.9889509,4.06666544 13.2254227,4.50975805 12.7549359,5.212 L12.7549359,17.777 L12.7782651,17.7601316 C13.4923805,17.2719483 14.3447024,17 15.2363079,17 L18.0059359,16.999 L18.0056891,4.798 L18.0033792,4.75457396 L18.0056891,4.71 L18.0059359,3.999 Z M8.9891247,4 L6.00368914,3.999 L6.00599909,4.75457396 L6.00599909,4.75457396 L6.00368914,4.783 L6.00368914,16.999 L8.77307039,17 C9.57551536,17 10.3461406,17.2202781 11.0128313,17.6202194 L11.2536891,17.776 L11.2536891,5.211 C10.8200889,4.56369974 10.1361548,4.13636104 9.37521067,4.02745763 L9.18347055,4.00692283 L8.9891247,4 Z"></path>
			</g>
		</svg>
	</button>
	<button
		type="button"
		class="toggle-right"
		data-reader-toggle="right"
		aria-label="Hide the page sidebar"
		title="Hide or show the page sidebar (graph, contents and backlinks)"
	>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="4" width="18" height="16" rx="2"></rect>
			<path d="M15 4v16"></path>
		</svg>
	</button>
</div>

<script>
	type Side = "left" | "right";
	const root = document.documentElement;
	const attribute = { left: "data-hide-left-sidebar", right: "data-hide-right-sidebar" } as const;
	const storageKey = { left: "hideLeftSidebar", right: "hideRightSidebar" } as const;

	const isHidden = (side: Side) => root.hasAttribute(attribute[side]);

	function setHidden(side: Side, hidden: boolean) {
		root.toggleAttribute(attribute[side], hidden);
		try {
			if (hidden) sessionStorage.setItem(storageKey[side], "true");
			else sessionStorage.removeItem(storageKey[side]);
		} catch {
			// Storage can be unavailable, e.g. in private browsing; the setting then lasts for this page.
		}
	}

	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-reader-toggle]");

	function updateButtons() {
		for (const button of buttons) {
			const target = button.dataset.readerToggle as Side | "both";
			const pressed = target === "both" ? isHidden("left") && isHidden("right") : isHidden(target);
			button.setAttribute("aria-pressed", String(pressed));
		}
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			const target = button.dataset.readerToggle as Side | "both";
			if (target === "both") {
				const readerMode = !(isHidden("left") && isHidden("right"));
				setHidden("left", readerMode);
				setHidden("right", readerMode);
			} else {
				setHidden(target, !isHidden(target));
			}
			updateButtons();
			// The graph view waits for its panel to be displayed before it loads (see Graph.astro).
			window.dispatchEvent(new Event("resize"));
		});
	}
	updateButtons();
</script>

<style is:global>
	.reader-mode {
		display: none;
		align-items: center;
		gap: 0.125rem;
	}
	.reader-mode button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0.3rem;
		border: 0;
		border-radius: 0.25rem;
		background: none;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.reader-mode button:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}
	.reader-mode button[aria-pressed="true"] {
		color: var(--sl-color-accent);
	}
	.reader-mode svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.reader-mode .toggle-right {
		display: none;
	}

	/* The buttons appear only where Starlight shows the sidebars side by side with the page. */
	@media (min-width: 50rem) {
		:root[data-has-sidebar] .reader-mode {
			display: flex;
		}
		:root[data-hide-left-sidebar] {
			--sl-content-inline-start: 0rem;
		}
		:root[data-hide-left-sidebar] .sidebar-pane {
			display: none;
		}
	}
	@media (min-width: 72rem) {
		:root[data-has-toc] .reader-mode .toggle-right {
			display: flex;
		}
		:root[data-hide-right-sidebar] .right-sidebar-container {
			display: none;
		}
		/* Starlight's header centres its search box as if there were no table of contents. */
		:root[data-hide-right-sidebar] {
			--__toc-width: 0rem;
		}
		:root[data-hide-right-sidebar] .main-pane {
			width: 100%;
		}
		/* With either sidebar hidden, centre the text in the space that's left. */
		:root[data-hide-left-sidebar] .main-pane,
		:root[data-hide-right-sidebar] .main-pane {
			--sl-content-margin-inline: auto;
		}
		/* With only the left one hidden, Starlight would widen the right sidebar into the freed space;
		   keep it at its usual width and give the space to the text column instead. */
		:root[data-hide-left-sidebar][data-has-toc]:not([data-hide-right-sidebar]) .right-sidebar-container {
			width: var(--sl-sidebar-width);
		}
		:root[data-hide-left-sidebar][data-has-toc]:not([data-hide-right-sidebar]) .main-pane {
			width: calc(100% - var(--sl-sidebar-width));
		}
	}
</style>
